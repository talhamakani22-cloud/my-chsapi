# ============================================================================
# CHS (Community Housing System) - Environment Configuration
# ============================================================================
# This file contains all environment variables needed for the application.
# Copy this to .env and fill in your actual values.
#
# ⚠️  IMPORTANT: NEVER commit .env to git repository!
# ============================================================================

# ============================================================================
# 🔐 DATABASE CONFIGURATION
# ============================================================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/chsdb?retryWrites=true&w=majority
DATABASE_NAME=chsdb

# ============================================================================
# 📧 EMAIL CONFIGURATION (for Anonymous Complaints)
# ============================================================================
# Email service for sending complaint notifications and verification links

# Gmail Configuration (Recommended)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM_NAME=CHS Complaints System

# Alternative: Custom SMTP Server
# EMAIL_SERVICE=smtp
# EMAIL_HOST=mail.yourdomain.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=complaints@yourdomain.com
# EMAIL_PASSWORD=your-password

# ============================================================================
# 🌐 APPLICATION CONFIGURATION
# ============================================================================
# Base URLs and environment settings

APP_URL=https://my-chsapi.onrender.com
APP_ENV=production
NODE_ENV=production
PORT=3000

# ============================================================================
# 📁 FILE UPLOADS
# ============================================================================
# Directory for storing uploaded files (images, videos, PDFs)

UPLOADS_DIR=./uploads
MAX_FILE_SIZE=52428800

# ============================================================================
# 🏢 BUILDING CONFIGURATION
# ============================================================================
# Building details for the complaint system

BUILDING_NAME=Your Building Name
BUILDING_CODE=BLD001
TOTAL_FLATS=50

# ============================================================================
# 🔑 SESSION & SECURITY
# ============================================================================
# Session and security configuration

SESSION_SECRET=your-super-secret-session-key-change-this
JWT_SECRET=your-jwt-secret-key-change-this
CORS_ORIGIN=https://my-chsapi.onrender.com,http://localhost:3000

# ============================================================================
# 📱 MOBILE APP CONFIGURATION
# ============================================================================
# Expo/React Native app configuration

EXPO_PUBLIC_API_URL=https://my-chsapi.onrender.com
EXPO_PUBLIC_APP_NAME=CHS Visitor Management

# ============================================================================
# 🔔 NOTIFICATION CONFIGURATION
# ============================================================================
# Push notifications and alerts

ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============================================================================
# 📊 LOGGING & MONITORING
# ============================================================================
# Application logging and monitoring

LOG_LEVEL=info
LOG_FILE=./logs/app.log
ENABLE_ANALYTICS=true

# ============================================================================
# 🚀 DEPLOYMENT CONFIGURATION
# ============================================================================
# Render.com and deployment settings

RENDER_EXTERNAL_URL=https://my-chsapi.onrender.com
RENDER_GIT_REPO=https://github.com/yourusername/repo

# ============================================================================
# 🧪 TESTING CONFIGURATION (Development Only)
# ============================================================================
# Only used in development/testing

TEST_MODE=false
TEST_EMAIL=test@example.com
SEED_DATA=false

# ============================================================================
# ⚠️  IMPORTANT NOTES
# ============================================================================
#
# 1. NEVER commit this file to git with actual credentials
# 2. Use .env.example as a template for team members
# 3. Add .env to .gitignore (should already be there)
# 4. Each environment (dev, staging, prod) needs separate .env file
# 5. Rotate credentials periodically
# 6. Use strong, unique values for secret keys
#
# For Gmail App Password:
#   - Go to: https://myaccount.google.com/apppasswords
#   - Enable 2-Step Verification first
#   - Generate 16-character password
#   - Use exact password without spaces
#
# For Render Deployment:
#   - Add these variables to Render environment settings
#   - Do NOT paste values in git - set them in Render dashboard only
#   - Render will handle secure variable storage
#
# For Local Development:
#   - Copy .env.example → .env
#   - Fill in your local values
#   - npm start will use these values
#
# ============================================================================
